; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zee's Airdrift"
run/main_scene="res://game/airdrift.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gs_server/plugin.cfg", "res://addons/gs_server_query/plugin.cfg", "res://addons/gs_net/plugin.cfg", "res://addons/gs_player_controller/plugin.cfg", "res://addons/gs_timer/plugin.cfg", "res://addons/gs_map/plugin.cfg", "res://addons/gs_leaderboard/plugin.cfg", "res://addons/gs_user_avatar/plugin.cfg", "res://addons/gs_physics/plugin.cfg", "res://addons/gs_spawn/plugin.cfg", "res://addons/gs_player/plugin.cfg", "res://addons/gs_player_char/plugin.cfg", "res://addons/gs_player_class/plugin.cfg", "res://addons/gs_team/plugin.cfg")

[importer_defaults]

texture={
"detect_3d/compress_to": 0
}

[physics]

common/physics_ticks_per_second=128

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[gamespice]

perf_game_id="airdrift"
